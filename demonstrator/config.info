; Ideal-gas Kelvin-Helmholtz run (EOS == 0, see include/parameter.h).
;
; Hydrodynamics only: no elastic/plastic/damage solid mechanics. The EOS is the
; ideal gas P = (gamma - 1) * rho * u with gamma set by `hydro_gamma` below.
;
; SML parameters are aligned with GIZMO's parameter file:
;   demonstrator NNNTarget = 32   <-> GIZMO DesNumNgb = 32 (KERNEL_FUNCTION=6)
; Iteration-specific knobs (tol, maxIter, hMin/MaxFactor) have no direct GIZMO
; counterpart - they're tuning the demonstrator's Newton iteration on h. Values
; here are deliberately tight (tol=1e-3) so the smoothing length is converged
; to the same level GIZMO converges to by its own iteration scheme.

initFile /home/sappler/Documents/newMFM/testcases/kelvin-helmholtz/khN62500.h5
outDir   /home/sappler/Documents/newMFM/testcases/kelvin-helmholtz/20260617/dummy_pressure_off/output

; Match GIZMO's MaxSizeTimestep=0.1 with ADAPTIVE_TIMESTEP enabled in parameter.h;
; output every 100 steps -> snapshot stride 1.0 (matches GIZMO's snapshot stride of 5
; if you sub-sample, but we keep finer here so the contact-phase dynamics are resolved).
timeStep 0.01
timeEnd  30
h5DumpInterval 10

; Demonstrator requires a periodic box even with PERIODIC_BOUNDARIES=0; just put
; the rings inside it. Hopkins IC extends to (+-9.93, +-4.00), so use a generous
; box that doesn't impose unphysical constraints.
periodicBoxLimits {
    lowerX  0.0
    lowerY  0.0
    lowerZ  0.0
    upperX  1.0
    upperY  1.0
    upperZ  0.0
}

; Hopkins IC has mean particle spacing ~0.086 (annulus area 7*pi over 2966
; particles per ring). 2x that as a starting kernel; the Newton iteration on h
; tunes it to hit NNNTarget exactly.
kernelSize 0.008

sml {
    ; Matches GIZMO DesNumNgb (KERNEL_FUNCTION=6 Wendland C2 -> 32)
    NNNTarget 32

    ; Newton iteration tolerance on |dh|/h
    tol       1e-3
    maxIter   200
    maxFactor 1.2
    hMinFactor 0.1
    hMaxFactor 3.0
    warnFraction  0.05
    panicFraction 0.25
}

; Ideal-gas EOS: P = (gamma - 1) * rho * u. The equation of state is selected at
; compile time via `#define EOS 0` in include/parameter.h (already set). Under
; EOS == 0 the demonstrator reads only `hydro_gamma`; the per-material `materials`
; table is for the Murnaghan (EOS 1) / Tillotson (EOS 2) solid-EOS paths and is
; ignored here. gamma = 5/3 (monatomic ideal gas).
hydro_gamma 1.6666666666666667

; --- Solid-EOS material tables (inactive: only read when EOS != 0) ------------
; To use one of these, set the matching `#define EOS` in include/parameter.h and
; uncomment the corresponding block below. The ideal-gas path above ignores them.
; Keys must match the parser in src/main.cpp (EOS == 1 / EOS == 2).
;
; Murnaghan EOS (EOS == 1): P = (K0/n) * ((rho/rho0)^n - 1).
; Keys: matId, K0 (bulk modulus), n (exponent), rho0 (ref density), mu (shear).
; Values from testcases/rip_test (K0=1, n=2, rho0=1) + SHEAR_MODULUS 0.22.
; materials {
;     mat0 {
;         matId 0
;         K0    1.0
;         n     2.0
;         rho0  1.0
;         mu    0.22
;     }
; }
;
; Tillotson EOS (EOS == 2): full a/b/A/B/alpha/beta form (Tillotson 1962;
; Benz & Asphaug 1995). Values below are the basalt material table from
; testcases/basalt_impact/config_base.info. The weibull*/Y*/mu_*/frictionAngle/
; u_melt keys are optional solid-failure params (default 0 = model off) and are
; only consumed when FRAGMENTATION / a *_PLASTICITY flag is set in parameter.h.
; materials {
;     mat0 {
;         matId 0
;         rho0  1.0
;         A     1.0
;         B     0.0
;         u0    1.0
;         a     0.0
;         b     0.0
;         alpha 0.0
;         beta  0.0
;         u_iv  0.05
;         u_cv  0.18
;         mu    0.22
;         ; --- optional solid-failure parameters ---
;         weibullK 5.0e12
;         weibullM 9.5
;         Y0    0.01
;         Y_M   0.03
;         mu_i  1.5
;         mu_d  0.6
;         frictionAngle 0.6
;         u_melt 0.5
;     }
; }
