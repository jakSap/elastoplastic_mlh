# Base configuration of the mto testplan: the 09-26 "standard" (GEF 1) + DRIFT_KDK 1
# + GIZMO's internal-energy limiter. Every flag that matters for the scheme is pinned
# here, so a build never depends on what demonstrator/include/parameter.h happens to
# hold in the working tree. Candidate files (candidates/*.flags) override these;
# testcase variants (lib/tests.py VARIANTS: periodicity, EOS, plasticity) override both.
DIM 2
ELASTIC 1
GRADIENT_ORDER 1
KERNEL_FUNCTION 6
NNN_TARGET 32
VARIABLE_SML 1
ADAPTIVE_TIMESTEP 1
CFL .2
MESHLESS_FINITE_MASS 1
SLOPE_LIMITING 1
PAIRWISE_LIMITER 1
USE_HLLC 1
USE_DUMMY_PRESSURE 1
# scheme: xSplitElasticHLLC isotropic on A_ij + GIZMO deviatoric stress flux
GIZMO_ELASTIC_FLUX 1
RECON_FACE_DV 1
RECON_FACE_TRACTION 0
ELASTIC_FACE_MODE 0
ELASTIC_HLLC_EP 0
AM_METHOD 0
# time integration
DRIFT_KDK 1
RECON_TIME_PRED 1
TIME_DKD 0
FRAME_HALFSTEP 0
# energy
MFM_ENERGY_STARFIX 0
ADIABATIC_FACE_CORRECTION 0
ENERGY_FLOOR -1
ENERGY_HALF_LIMIT 1
# tensile correction (local, scale-free form)
TENSILE_CORRECTION 1
TENSILE_CORRECTION_1 1
TENSILE_CORRECTION_2 0
TENSILE_CORRECTION_3 0
TENSILE_CORRECTION_LOCAL 1
TENSILE_CORRECTION_FMAX 0.5
TENSILE_CORRECTION_DAMP 8.0
TENSILE_CORRECTION_PREFAC 4.0
TENSILE_CORRECTION_POWER 1.
# deviatoric TC on the part that is tensile in the TOTAL principal stress (standard since 10-03)
TC_TOTAL_STRESS_GATE 1
# volume / surface
EXPLICIT_VOL_INTEGRATION 1
EXPLICIT_VOL_SPH_DIVV 0
SURFACE_GRAD_BLEND 1
SURFACE_VOLCORR 1
POLY_RECONSTRUCTION 0
# physics off unless a variant switches it on
PLASTICITY 0
VON_MISES_PLASTICITY 0
PLASTICITY_YIELD_GIZMO 0
FRAGMENTATION 0
# diagnostics off
TORQUE_DIAG 0
AM_SELFTEST 0
# Old parameter.h defaults, pinned when the mto winner fin1_g2_eta1_mn became the parameter.h default
# (2026-10-03): keeps ref and every logged candidate bit-identical. Winner = candidates/fin1_g2_eta1_mn.flags.
STRESS_2D_GIZMO 0
RIEMANN_PSTAR_FLOOR 0
STRESS_RATE_RAW_GRAD 0
HLLC_WAVESPEED_GIZMO 0
CONTACT_NO_TENSION 0
SLOPE_LIMITER_EPS 0.
RECON_FACE_DV6_S0 1e-3
RECON_FACE_DV7_S0T 5e-3
NL_SWITCH_TC 0
NL_SWITCH_DIVV 0
NL_SWITCH_FACE 0
NL_SWITCH_TAU 0.
GNOG_PENALTY 0
MATERIAL_VISCOSITY 0
VISC_MOMENT_NORM 0
