; h5 file containing the initial particle distribution
; generate with: python3 generateIC.py -d 0.025 -v 0.059 --plot
initFile ../testcases/two_blocks/two_blocks_deltap0.025-2D.h5

; output directory for particle distribution h5 files
outDir ../testcases/two_blocks/output

; fixed time step
; when ADAPTIVE_TIMESTEP is set in parameter.h,
; this gives the output timestep stride combined with h5DumpInterval
timeStep 0.001

; end of the simulation
timeEnd 5.0

; output particle distribution each h5DumpInterval steps
h5DumpInterval 100

; periodic boundaries of box (2x1 domain centered at origin)
; ignored when PERIODIC_BOUNDARIES is not set in parameter.h
periodicBoxLimits {
    lowerX -1.0
    lowerY -0.5
    lowerZ  0.
    upperX  1.0
    upperY  0.5
    upperZ  0.
}

; kernel size for meshless scheme (roughly 2x mean particle distance)
; for delta_p = 0.025 -> kernelSize ~ 0.05
kernelSize 0.075

; adiabatic index (unused when EOS != 0, kept for config parser compatibility)
hydro_gamma 1.6666666666666667

; Murnaghan EOS parameters (used when EOS == 1 in parameter.h)
; K0: bulk modulus, n: Murnaghan exponent, rho0: reference density
MURN_K0   1.0
MURN_n    2.0
MURN_rho0 1.0
