; LIMITER EXPERIMENT (limiterTest.sh): variant limSL, build limiter_builds/build_tillotson_limSL
; 2D linear travelling soundwave (Hopkins 2015, sec. 4.2.1), tillotson EOS,
; 128 x 32 particles (n = 128 per wavelength), N_NN = 32.
; Build: build_tillotson/ -- EOS 2, ELASTIC 1 + GIZMO_ELASTIC_FLUX 0 (xSplitElasticHLLC),
;        mu = 0 (no solid dynamics), TENSILE_CORRECTION 1, SURFACE_VOLCORR 0,
;        EXPLICIT_VOL_INTEGRATION 1, PERIODIC_BOUNDARIES 1, Wendland C2. See makeBuilds.sh.
; Run from this directory:  build_tillotson/bin/mlh -c config_tillotson_N128.info   (or ./runAll.sh)

initFile soundwave_tillotson_N128.h5
outDir   output_tillotson_N128_limSL

; One wave period, lambda/c = 1. ADAPTIVE_TIMESTEP: snapshots every
; timeStep*h5DumpInterval = 0.01.
timeStep 0.01
timeEnd  1.0
h5DumpInterval 1

periodicBoxLimits {
    lowerX 0.0
    lowerY 0.0
    lowerZ 0.0
    upperX 1.0
    upperY 0.25
    upperZ 0.0
}

; ~ kernel support for N_NN = 32 on the lattice: sqrt(N_NN/pi) * dx, dx = 1/128
kernelSize 0.0249339

sml {
    NNNTarget 32
    tol       1e-3
    maxIter   200
    maxFactor 1.2
    hMinFactor 0.1
    hMaxFactor 3.0
    warnFraction  0.05
    panicFraction 0.25
}

; read only for EOS 0, kept for config-parser compatibility
hydro_gamma 1.6666666666666667

; Hopkins-canonical Tillotson (testcases/periodic_wall_bounce): a = b = B = 0,
; alpha = beta = 0 -> P = A (rho/rho0 - 1) in every regime, c^2 = A/rho0 = 1.
; The kernel-sum density offset (+4.2e-3 at N_NN = 32) gives P_bar = +4.2e-3.
; IC u = 0.01 > 0 (u <= 0 logs an ERROR every step), below u_iv so the cold
; branch is used. mu = 0: no deviatoric stress.
materials {
    mat0 {
        matId 0
        rho0  1.0
        A     1.0
        B     0.0
        u0    1.0
        a     0.0
        b     0.0
        alpha 0.0
        beta  0.0
        u_iv  0.05
        u_cv  0.18
        mu    0.0
    }
}
