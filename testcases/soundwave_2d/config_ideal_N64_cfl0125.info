; 2D linear travelling soundwave (Hopkins 2015, sec. 4.2.1), ideal EOS,
; 64 x 16 particles (n = 64 per wavelength), N_NN = 32.
; Build: build_ideal/ -- EOS 0, ELASTIC 1 + GIZMO_ELASTIC_FLUX 0 (xSplitElasticHLLC),
;        mu = 0 (no solid dynamics), TENSILE_CORRECTION 1, SURFACE_VOLCORR 0,
;        EXPLICIT_VOL_INTEGRATION 1, PERIODIC_BOUNDARIES 1, Wendland C2. See makeBuilds.sh.
; Run from this directory:  build_ideal/bin/mlh -c config_ideal_N64.info   (or ./runAll.sh)

initFile soundwave_ideal_N64.h5
outDir   output_ideal_N64_cfl0125

; One wave period, lambda/c = 1. ADAPTIVE_TIMESTEP: snapshots every
; timeStep*h5DumpInterval = 0.01.
timeStep 0.01
timeEnd  1.0
h5DumpInterval 1

periodicBoxLimits {
    lowerX 0.0
    lowerY 0.0
    lowerZ 0.0
    upperX 1.0
    upperY 0.25
    upperZ 0.0
}

; ~ kernel support for N_NN = 32 on the lattice: sqrt(N_NN/pi) * dx, dx = 1/64
kernelSize 0.0498678

sml {
    NNNTarget 32
    tol       1e-3
    maxIter   200
    maxFactor 1.2
    hMinFactor 0.1
    hMaxFactor 3.0
    warnFraction  0.05
    panicFraction 0.25
}

; Hopkins: gamma = 5/3, rho = 1, P = 3/5 -> c = 1 (u = 0.9 in the IC).
; c^2 = gamma (gamma - 1) u does not depend on rho, so the kernel-sum density
; offset only shifts P_bar.
hydro_gamma 1.6666666666666667
